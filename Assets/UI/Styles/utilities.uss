.flex-grow-1 {
    flex-grow: 1;
}

.flex-grow-2 {
    flex-grow: 2;
}

.flex-basis-0 {
    flex-basis: 0%;
}

.transparent {
    background-color: rgba(0, 0, 0, 0);
}

.mt-10 {
    margin-top: 10px;
}

.p-4 {
    padding: 4px;
}

.border {
    border-color: rgb(223, 209, 190);
    border-width: 2px;
}

.rounded {
    border-radius: 15px;
}

.surface {
    background-color: rgb(244, 235, 225);
}

.text-outline {
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-text-outline-width: 0.8px;
}

.text-center {
    -unity-text-align: middle-center;
}

.text-gray {
    color: gray;
}

.font-bold {
    -unity-font-style: bold;
}

.text-16 {
    font-size: 16px;
}

.text-20 {
    font-size: 20px;
}


