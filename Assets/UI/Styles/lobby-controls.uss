.lobby-code-field {
    flex-direction: row;
    align-self: stretch;
    align-items: center;
    margin-top: 10px;
    min-width: 0;
    min-height: 52px;
    flex-shrink: 0;
    margin-left: 70px;
}

.lobby-code-label {
    flex-grow: 1;
    min-width: 0;
    max-width: 300px;
    height: 52px;
    margin-right: 8px;
    padding-left: 12px;
    padding-right: 12px;
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-text-outline-width: 0.5px;
    letter-spacing: 3px;
    white-space: nowrap;
}

.lobby-code-button {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    padding: 0;
    background-size: 50% 50%;
    background-repeat: no-repeat;
    background-position: center;
    background-image: url("project://database/Assets/Art/Icons/copy-icon.svg?fileID=7388822144124034973&guid=92a365c9b50b1dc42907aa4852fca9de&type=3#copy-icon");
}

.lobby-code-button:hover {
    background-color: rgb(235, 226, 216);
}

.lobby-code-button:active {
    background-color: rgb(229, 221, 211);
}

.players-title {
    flex-direction: row;
    margin-top: 10px;
    margin-right: 20px;
    margin-bottom: 10px;
    margin-left: 20px;
}

.players-title-icon {
    height: 64px;
    width: 64px;
    aspect-ratio: 1;
    background-image: url("project://database/Assets/Art/Icons/users-icon.png?fileID=2800000&guid=78d2aaae5de12a34b9ec24580d61202e&type=3#users-icon");
}

.players-title-label {
    font-size: 32px;
    -unity-text-align: middle-left;
    margin-left: 15px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.player-slot {
    height: 128px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(223, 209, 190);
    border-right-color: rgb(223, 209, 190);
    border-top-color: rgb(223, 209, 190);
    border-bottom-color: rgb(223, 209, 190);
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
}

.player-avatar {
}

.players-list {
    flex-basis: 0;
    flex-grow: 4;
}

.chat-history-container {
    flex-grow: 3;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 0;
    margin-left: 10px;
}

.chat-history {
    margin-top: 12px;
    margin-right: 12px;
    margin-bottom: 12px;
    margin-left: 12px;
    flex-grow: 1;
}

.chat-field {
    margin-top: 12px;
    margin-right: 12px;
    margin-bottom: 12px;
    margin-left: 12px;
    flex-grow: 1;
}

.chat-title {
    flex-direction: row;
    margin-left: 20px;
    align-items: center;
    margin-top: 10px;
    border-bottom-color: rgb(237, 222, 201);
    border-bottom-width: 2px;
    margin-right: 20px;
    padding-bottom: 10px;
}

.chat-title-icon {
    width: 42px;
    height: 42px;
    background-image: url("project://database/Assets/Art/Icons/chat-icon.png?fileID=2800000&guid=ef246d6699eb19c429ed4db6a476b0a8&type=3#chat-icon");
}

.chat-title-label {
    margin-left: 15px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(0, 0, 0);
    font-size: 32px;
}
